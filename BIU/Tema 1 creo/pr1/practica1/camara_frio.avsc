{
  "type": "record",
  "name": "EventoCamaraFrigorifica",
  "fields": [
    {
      "name": "sensor_id",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": "string"
    },
    {
      "name": "temperature_c",
      "type": "double"
    },
    {
      "name": "door_open",
      "type": "boolean"
    },
    {
      "name": "battery_percent",
      "type": ["null", "int"],
      "default": null
    }
  ]
}
